.cache/

# Test databases
data/*.db
packages/connector/data/*.db

# Test runtime artifacts — ledger snapshots + claim DBs + anon SDK state.
# These accumulate during test runs with randomized port-base suffixes and
# must never be committed (contains transient state, not source).
packages/connector/data/ledger-*.json
packages/connector/terms-agreement

# Playwright test artifacts
.playwright-mcp/

# Docker volumes
.docker-data/

# Devbox virtualenv (Nix symlinks + package cache — never commit)
.devbox/

