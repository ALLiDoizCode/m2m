# BMAD framework (already in repo, don't ignore)
# .bmad-core/
# .bmad-creative-writing/
# .bmad-infrastructure-devops/
# .claude/
.auto-bmad-tmp/

# Agent worktrees. `.claude/` itself is tracked (the BMAD commands above), so
# this ignores only the checkouts agents create underneath it — currently
# multiple GB on a working machine. Previously untracked via a local, uncommitted
# `.git/info/exclude`, which a fresh clone does not inherit.
**/.claude/worktrees/

# Mina zkApp ESM build (faucet USDC-mint single-instance bundle) — built at image time
packages/mina-zkapp/dist-esm/
# Per-recreate lightnet zkApp deploy result (contains sensitive admin/token keys)
infra/linode-node/mina-lightnet.json

# Rust connector deploy quickstart — real key material generated by
# deploy/connector-rust/README.md's own steps, never committed
deploy/connector-rust/signer.key
deploy/connector-rust/operator.pem

# Rust connector devnet overlay (issue #490) — real per-box key material,
# never committed; mirrors deploy/connector-rust/signer.key above.
infra/linode-node/signer-rust.key
infra/linode-store/signer-rust.key
