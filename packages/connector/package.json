{
  "name": "@toon-protocol/connector",
  "version": "3.44.2",
  "description": "TypeScript client for the ILP connector's client edge",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ALLiDoizCode/connector.git",
    "directory": "packages/connector"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "keywords": [
    "interledger",
    "ilp",
    "connector",
    "client"
  ],
  "homepage": "https://github.com/ALLiDoizCode/connector/tree/main/packages/connector#readme",
  "bugs": {
    "url": "https://github.com/ALLiDoizCode/connector/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:publish": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:rfc-links": "jest test/unit/rfc-links.test.ts",
    "test:unit": "jest --testPathIgnorePatterns='test/integration'",
    "test:integration": "jest --testPathPattern=test/integration",
    "lint": "eslint src --ext .ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build:publish && npm test"
  },
  "dependencies": {
    "@toon-protocol/shared": "^1.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
