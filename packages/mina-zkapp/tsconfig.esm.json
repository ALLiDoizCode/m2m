{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist-esm",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/constants.ts",
    "src/usdc-token.ts",
    "src/usdc-channel-token.ts",
    "src/usdc-deploy.ts",
    "src/usdc-faucet.ts",
    "src/PaymentChannel.ts"
  ]
}
