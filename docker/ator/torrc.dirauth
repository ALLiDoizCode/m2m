# torrc template — DirAuth role (test network only)
# Variables substituted by entrypoint.sh via envsubst:
#   ${NICKNAME} ${ORPORT} ${DIRPORT} ${CONTROL_PORT}
#   ${DIRAUTH1_LINE} ${DIRAUTH2_LINE} ${DIRAUTH3_LINE}
Nickname ${NICKNAME}
Address ${MY_IP}
DataDirectory /var/lib/anon
ContactInfo test-dirauth@local
Log notice stdout
RunAsDaemon 0

# Non-live test network — required for short voting intervals and self-signed auth
TestingTorNetwork 1
AgreeToTerms 1
V3AuthVotingInterval 20 seconds
V3AuthVoteDelay 4 seconds
V3AuthDistDelay 4 seconds
AssumeReachable 1
ProtocolWarnings 1
# Single /24 bridge network with only 4 relays — disable same-/16 path
# restriction and conflux multi-path circuits so clients and hidden
# services can build circuits. See docker/ator/torrc.hs for rationale.
EnforceDistinctSubnets 0
ConfluxEnabled 0

# DirAuth identity
AuthoritativeDirectory 1
V3AuthoritativeDirectory 1

# Ports
ORPort ${ORPORT}
DirPort ${DIRPORT}
# ControlPort bound to localhost only — defense-in-depth. Other containers on
# ator_net MUST NOT reach the control interface. CookieAuthentication requires
# a client to possess the auth cookie file from DataDirectory.
ControlPort 127.0.0.1:${CONTROL_PORT}
CookieAuthentication 1
SocksPort 0

# No exit from DirAuth nodes
ExitRelay 0
ExitPolicy reject *:*

# The three DirAuthority lines (self + peers) — populated at render time
${DIRAUTH1_LINE}
${DIRAUTH2_LINE}
${DIRAUTH3_LINE}
