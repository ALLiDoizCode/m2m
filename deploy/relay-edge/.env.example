# =============================================================================
# relay-edge — copy to `.env` and edit.
# Two knobs matter: TOON_MNEMONIC (connector identity) and
# RELAY_NOSTR_SECRET_KEY (relay identity — REQUIRED, the relay won't boot without it).
# =============================================================================

# ── CONNECTOR IDENTITY (on-chain settlement) ─────────────────────────────────
# A BIP-39 seed phrase. The connector derives its on-chain settlement key from
# this at boot. Leave EMPTY to use the pre-funded anvil account-0 devnet fallback
# (good for a first smoke test; the round-trip client opens its channel toward
# that address by default).
#
# IMPORTANT: if you SET a mnemonic, the connector's settlement address changes,
# so you MUST update routes[].settlementAddresses.evm in connector.yaml to the
# EVM address the connector prints at boot (log line: "mnemonic_signing_mode_enabled
# ... evmAddress=0x..."). Otherwise payers open channels to the wrong address.
TOON_MNEMONIC=

# ── RELAY IDENTITY (Nostr key — NOT money) ───────────────────────────────────
# REQUIRED. The relay CLI refuses to boot without an identity key. This is the
# relay's Nostr secret key (identity only — it does not hold or move funds).
# Generate an ephemeral 32-byte hex, e.g.:
#   openssl rand -hex 32
RELAY_NOSTR_SECRET_KEY=

# Enforce Nostr signature verification on paid writes. MUST be false in public
# deploys (i.e. verification ON). Set true ONLY for local smoke fixtures.
RELAY_DEV_MODE=false

# ── SHARED LIVE DEVNET ───────────────────────────────────────────────────────
# The connector settles against these. They are also baked (literally) into
# connector.yaml's chainProviders[].rpcUrl — the config loader does NOT expand
# ${...}, so changing the RPC means editing connector.yaml too. The round-trip
# client reads EVM_RPC_URL / FAUCET_URL from its own env.
EVM_RPC_URL=https://evm-rpc.devnet.toonprotocol.dev
FAUCET_URL=https://faucet.devnet.toonprotocol.dev

# ── DEVNET CAVEAT: self-signed TLS ───────────────────────────────────────────
# The shared devnet serves a self-signed cert. This disables Node TLS
# verification for the connector's RPC/faucet calls ONLY. The PUBLIC edge
# (Caddy) still serves TRUSTED Let's Encrypt certs. DEVNET-ONLY.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Images / logging (optional) ──────────────────────────────────────────────
CONNECTOR_IMAGE=ghcr.io/toon-protocol/connector:latest
RELAY_IMAGE=ghcr.io/toon-protocol/relay:latest
LOG_LEVEL=info
