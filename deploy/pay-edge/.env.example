# =============================================================================
# pay-edge — copy to `.env` and edit. The ONE knob that matters is TOON_MNEMONIC.
# =============================================================================

# ── YOUR IDENTITY (the only thing you must set) ──────────────────────────────
# A BIP-39 seed phrase. The connector derives its on-chain settlement key from
# this at boot. Leave EMPTY to use the pre-funded anvil account-0 devnet fallback
# (fine for a first smoke test; use your own seed for anything real).
#
# IMPORTANT: if you SET a mnemonic, the connector's settlement address changes,
# so you MUST update routes[].settlementAddresses.evm in connector.yaml to the
# EVM address the connector prints at boot (log line: "mnemonic_signing_mode_enabled
# ... evmAddress=0x..."). Otherwise payers open channels to the wrong address.
TOON_MNEMONIC=

# ── SHARED LIVE DEVNET ───────────────────────────────────────────────────────
# The connector settles against these. They are also baked (literally) into
# connector.yaml's chainProviders[].rpcUrl — the config loader does NOT expand
# ${...}, so changing the RPC means editing connector.yaml too.
EVM_RPC_URL=https://evm-rpc.devnet.toonprotocol.dev
FAUCET_URL=https://faucet.devnet.toonprotocol.dev

# Devnet box IP. DNS (*.devnet.toonprotocol.dev) already points here, so this is
# only needed as a stopgap if the box moves and DNS lags (see docker-compose.yml
# extra_hosts + dns-pin.js).
DEVNET_IP=50.116.58.45

# ── DEVNET CAVEAT: untrusted TLS ─────────────────────────────────────────────
# The devnet serves a Let's Encrypt *staging* (untrusted) cert. This disables
# Node TLS verification for the connector's RPC/faucet calls. DEVNET-ONLY.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Image / logging (optional) ───────────────────────────────────────────────
# Pin the connector image. Default is the published :latest; for a locally built
# image use `connector:standalone-e2e`.
CONNECTOR_IMAGE=ghcr.io/toon-protocol/connector:latest
LOG_LEVEL=info
