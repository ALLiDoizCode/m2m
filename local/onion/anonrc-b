##=================== /etc/anon/anonrc -- local/onion, B's side ==============##
#
# The onion SERVICE. This daemon generates `connector-b`'s address, publishes
# a descriptor for it, and forwards what arrives to the connector's one
# listener. It opens no SOCKS port: B dials nothing.
#
# Mounted READ-ONLY at /etc/anon/anonrc; see `anonrc-a` for why the `Nickname`
# line below cannot be dropped.

# WITHOUT THIS THE DAEMON DOES NOT START -- see `anonrc-a`.
AgreeToTerms 1

User anond
DataDirectory /var/lib/anon
Nickname toonlocalonionB

ClientOnly 1
SocksPort 0
ORPort 0
DirPort 0
ControlSocket 0

# ── The address, and where it lives ─────────────────────────────────────────
# `anon` writes the generated address to `HiddenServiceDir/hostname` and the
# private key beside it. THIS DIRECTORY IS INSIDE THE NAMED VOLUME compose
# mounts at /var/lib/anon, which is what ADR 0070's Consequences require: "if
# HiddenServiceDir is not on a persisted volume, the node's address changes on
# every restart and every counterparty's config goes stale silently". It
# belongs beside `state_dir` in an operator's head for exactly that reason.
#
# A SUBDIRECTORY of the DataDirectory volume rather than a second mount of its
# own, and that is an ownership argument, not tidiness: the image ships
# /var/lib/anon owned by its unprivileged user, so a fresh named volume
# mounted there inherits that ownership -- the same reason every connector
# here mounts a NAMED volume at /app/state rather than a host bind mount.
#
# The key is never committed and never leaves the volume.
# `tools/ci/check-tracked-secrets.sh` would refuse it, and a fixed onion key in
# a public repository is an address anyone could impersonate.
HiddenServiceDir /var/lib/anon/hidden_service

# ONE port for BOTH surfaces. `connector-b:3000` is the single listener the
# connector binds: `GET /ilp/btp` upgrades the peering's websocket and
# `POST /ilp` serves the client edge A asks claim-state on. An onion address
# is a host, so it is addressed the way any other host would be -- port 80,
# and the paths decide the rest.
HiddenServicePort 80 connector-b:3000

Log notice stdout
Log notice file /var/lib/anon/notice.log
