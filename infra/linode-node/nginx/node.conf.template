# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TOON connector node nginx config.
# Serves: relay-ws.DOMAIN  proxy.DOMAIN  faucet.DOMAIN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

limit_req_zone $binary_remote_addr zone=node:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $host $backend {
    default               "";
    relay-ws.${DOMAIN}    "http://relay:7100";
    proxy.${DOMAIN}       "http://connector:3000";
    faucet.${DOMAIN}      "http://faucet:3500";
}

server {
    listen 80;
    listen [::]:80;
    server_name relay-ws.${DOMAIN} proxy.${DOMAIN} faucet.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name relay-ws.${DOMAIN} proxy.${DOMAIN} faucet.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/relay-ws.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay-ws.${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        if ($backend = "") { return 404; }
        limit_req zone=node burst=60 nodelay;

        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;

        client_max_body_size 4m;
    }
}
