# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mina lightnet nginx config.
# Used when NGINX_TEMPLATE=mina.conf.template (dedicated Mina lightnet box).
# Proxies:
#   mina.DOMAIN/graphql        → local mina-lightnet:3085 (GraphQL)
#   mina-accounts.DOMAIN       → local mina-lightnet:8181 (accounts manager)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

limit_req_zone $binary_remote_addr zone=rpc:10m rate=30r/s;

server {
    listen 80;
    listen [::]:80;
    server_name mina.${DOMAIN} mina-accounts.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# GraphQL endpoint for the Mina lightnet
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mina.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/mina.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mina.${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location /graphql {
        limit_req zone=rpc burst=60 nodelay;
        proxy_pass http://mina-lightnet:3085/graphql;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        client_max_body_size 4m;
    }
    location / { return 404; }
}

# Accounts manager — lets clients acquire pre-funded Mina devnet accounts
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mina-accounts.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/mina.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mina.${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        limit_req zone=rpc burst=20 nodelay;
        proxy_pass http://mina-lightnet:8181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
