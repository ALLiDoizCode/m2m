# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Solana-only devnet node nginx config.
# Used when NGINX_TEMPLATE=sol.conf.template in .env (single-chain Solana box).
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

limit_req_zone $binary_remote_addr zone=rpc:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Route solana-rpc WS upgrades to port 8900 (JSON-RPC HTTP stays on 8899).
# @solana/web3.js derives wss://solana-rpc.* from the RPC URL for confirmations.
map "$host:$http_upgrade" $backend {
    default                          "";
    "solana-rpc.${DOMAIN}:websocket" "http://solana-validator:8900";
    "solana-rpc.${DOMAIN}:"          "http://solana-validator:8899";
    "solana-ws.${DOMAIN}:websocket"  "http://solana-validator:8900";
    "solana-ws.${DOMAIN}:"           "http://solana-validator:8900";
}

server {
    listen 80;
    listen [::]:80;
    server_name solana-rpc.${DOMAIN} solana-ws.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name solana-rpc.${DOMAIN} solana-ws.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/solana-rpc.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/solana-rpc.${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        if ($backend = "") { return 404; }
        limit_req zone=rpc burst=60 nodelay;

        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;

        client_max_body_size 4m;
    }
}
