# TOON Linode devnet — copy to .env and edit. Sourced by bootstrap.sh / devnet.sh.

# Base domain. The devnet is served on these subdomains (create A-records → Linode IP):
#   evm-rpc.${DOMAIN}     solana-rpc.${DOMAIN}   solana-ws.${DOMAIN}
#   faucet.${DOMAIN}      mina.${DOMAIN}
DOMAIN=devnet.example.com

# Email Let's Encrypt uses for expiry notices.
LETSENCRYPT_EMAIL=ops@example.com

# Use Let's Encrypt staging while testing (1 = staging certs, untrusted but no
# rate limits). Set to 0 for real, trusted certs.
LETSENCRYPT_STAGING=1

# Which chains to run. EVM (anvil+faucet) + Solana validator. We proxy public
# Mina devnet, so do NOT add `mina` (that would start the heavy 8 GB lightnet).
COMPOSE_PROFILES=evm,solana

# Public network interface the firewall locks the raw chain ports off of.
# Find it with: ip route get 1.1.1.1 | awk '{print $5; exit}'
PUBLIC_IFACE=eth0
